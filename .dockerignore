# Dependencies and build output (rebuilt inside the image)
**/node_modules
backend/dist
frontend/dist
backend/coverage
frontend/coverage

# Secrets and local env
**/.env
**/.env.*
!**/.env.example

# VCS and tooling
.git
.gitignore
**/*.log
.DS_Store

# Tests / E2E artifacts not needed in the image
frontend/test-results
frontend/playwright-report
