# Example environment for the production-like Docker stack.
# Copy to .env.prod and adjust as needed:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# The values below are safe DEMO defaults for local evaluation only.
# For a real/public deployment, replace JWT_SECRET and the admin credentials
# with strong secret values and never commit them.

# --- Database (used by the Postgres container and the app) ---
POSTGRES_USER=gymDbUser
POSTGRES_PASSWORD=gymDbLocalPass
POSTGRES_DB=gymDb

# --- App ---
PORT=3000

# Secret used to sign auth session JWTs - use a long random value in real deployments.
JWT_SECRET=local-demo-jwt-secret-change-me

# Single admin account, created by the seed script (npx prisma db seed).
# These are the credentials to log in with after seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Dashboard "due soon" threshold in days (optional, defaults to 5).
DASHBOARD_DUE_SOON_DAYS=5
