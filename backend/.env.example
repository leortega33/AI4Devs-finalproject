# Copy this file to .env and fill in real values for your environment.
DATABASE_URL="postgresql://gymDbUser:gymDbLocalPass@localhost:5432/gymDb"
PORT=3000
NODE_ENV=development

# Secret used to sign auth session JWTs - use a long random value
# (this is a demo default for local use only; use a real random value elsewhere)
JWT_SECRET=local-dev-jwt-secret-change-me

# Single admin account, created by the seed script (see prisma/seed.ts)
# Demo defaults for local/evaluation use — change them for any real deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Set to "true" to disable auth rate limiting (login / forgot-password).
# Only honored when NODE_ENV is not "production" — intended for local E2E runs
# that log in many times. Leave unset/false in normal use.
RATE_LIMIT_DISABLED=false

# Dashboard "due soon" threshold in days: payments/routines ending within this
# many days are flagged as upcoming (see US-009). Defaults to 5.
DASHBOARD_DUE_SOON_DAYS=5

# Deployment (single-origin): when "true", the backend also serves the built
# frontend as static files (see docs/deployment.md). Leave off/unset in dev.
SERVE_FRONTEND=false
# Path to the built frontend to serve when SERVE_FRONTEND=true.
# Defaults to ../public relative to the compiled backend (dist/). Set by the Docker image.
CLIENT_DIST=

# Automated email reminders (US-024). Opt-in: the scheduler runs only when
# REMINDERS_ENABLED=true. Without RESEND_API_KEY, emails are logged (dev), not sent.
REMINDERS_ENABLED=false
# Cron expression for the reminder job (default: 9am daily).
REMINDER_CRON=0 9 * * *
# Resend API key (https://resend.com). Keep secret; never commit a real value.
RESEND_API_KEY=
# From address used for reminder/reset emails when Resend is configured.
REMINDER_FROM_EMAIL=no-reply@example.com

# Progress photos (US-026b). Storage backend for uploaded photos.
# "local" (default) writes files under PHOTO_STORAGE_DIR; "s3" is reserved for a
# future object-storage backend and is not implemented yet.
PHOTO_STORAGE=local
# Directory where progress photos are stored when PHOTO_STORAGE=local.
# Defaults to ./uploads in dev; the Docker image mounts a persistent volume here
# (see docs/deployment.md).
PHOTO_STORAGE_DIR=./uploads
