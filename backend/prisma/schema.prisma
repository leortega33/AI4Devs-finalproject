generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the musl target is for the Alpine-based Docker image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique
  passwordHash           String
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

enum ClientStatus {
  active
  inactive
}

enum ExerciseCategory {
  mobility
  activation
  main
}

enum RoutineStatus {
  draft
  active
  expired
}

enum RoutinePhase {
  warmup
  main
}

enum PaymentMethod {
  cash
  bank_transfer
  card
}

model Client {
  id                           Int          @id @default(autoincrement())
  firstName                    String
  lastName                     String
  dni                          String       @unique
  phone                        String
  email                        String
  birthDate                    DateTime
  address                      String?
  goal                         String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  joinDate                     DateTime     @default(now())
  status                       ClientStatus @default(active)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  medicalRecord         MedicalRecord?
  medicalRecordVersions MedicalRecordVersion[]
  routines              RoutineTemplate[]
  payments              Payment[]
}

model MedicalRecord {
  id                     Int      @id @default(autoincrement())
  clientId               Int      @unique
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preexistingConditions  String?
  injuries               String?
  surgeriesOrProsthetics String?
  physicalRestrictions   String?
  medication             String?
  allergies              String?
  bloodType              String?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model MedicalRecordVersion {
  id                     Int      @id @default(autoincrement())
  clientId               Int
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preexistingConditions  String?
  injuries               String?
  surgeriesOrProsthetics String?
  physicalRestrictions   String?
  medication             String?
  allergies              String?
  bloodType              String?
  notes                  String?
  createdAt              DateTime @default(now())

  @@index([clientId, createdAt])
}

model Exercise {
  id          Int              @id @default(autoincrement())
  name        String
  muscleGroup String
  category    ExerciseCategory
  defaultSets Int?
  defaultReps Int?
  technique   String?
  equipment   String?
  videoUrl    String?
  imageUrl    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  routineEntries RoutineExerciseEntry[]
}

model RoutineTemplate {
  id                    Int              @id @default(autoincrement())
  name                  String
  description           String?
  objective             String?
  generalConsiderations String?
  clientId              Int?
  client                Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceTemplateId      Int?
  sourceTemplate        RoutineTemplate? @relation("TemplateClone", fields: [sourceTemplateId], references: [id])
  clones                RoutineTemplate[] @relation("TemplateClone")
  startDate             DateTime?
  durationWeeks         Int?
  status                RoutineStatus    @default(draft)
  sessions              RoutineSession[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model RoutineSession {
  id                 Int                    @id @default(autoincrement())
  routineTemplateId  Int
  routineTemplate    RoutineTemplate        @relation(fields: [routineTemplateId], references: [id], onDelete: Cascade)
  name               String
  warmupPrescription String?
  order              Int
  entries            RoutineExerciseEntry[]
}

model RoutineExerciseEntry {
  id               Int            @id @default(autoincrement())
  routineSessionId Int
  routineSession   RoutineSession @relation(fields: [routineSessionId], references: [id], onDelete: Cascade)
  exerciseId       Int
  exercise         Exercise       @relation(fields: [exerciseId], references: [id])
  phase            RoutinePhase
  block            String?
  kg               Float?
  reps             Int?
  series           Int?
  notes            String?
  order            Int
  weeks            RoutineExerciseWeek[]
}

model RoutineExerciseWeek {
  id                     Int                  @id @default(autoincrement())
  routineExerciseEntryId Int
  routineExerciseEntry   RoutineExerciseEntry @relation(fields: [routineExerciseEntryId], references: [id], onDelete: Cascade)
  week                   Int
  kg                     Float?
  reps                   Int?
  series                 Int?

  @@unique([routineExerciseEntryId, week])
}

model Payment {
  id          Int           @id @default(autoincrement())
  clientId    Int
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(10, 2)
  paymentDate DateTime
  method      PaymentMethod
  periodMonth Int
  periodYear  Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
