generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique
  passwordHash           String
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

enum ClientStatus {
  active
  inactive
}

enum ExerciseCategory {
  mobility
  activation
  main
}

enum RoutineStatus {
  draft
  active
  expired
}

enum RoutinePhase {
  warmup
  main
}

model Client {
  id                           Int          @id @default(autoincrement())
  firstName                    String
  lastName                     String
  dni                          String       @unique
  phone                        String
  email                        String
  birthDate                    DateTime
  address                      String?
  goal                         String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  joinDate                     DateTime     @default(now())
  status                       ClientStatus @default(active)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  medicalRecord MedicalRecord?
  routines      RoutineTemplate[]
}

model MedicalRecord {
  id                     Int      @id @default(autoincrement())
  clientId               Int      @unique
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preexistingConditions  String?
  injuries               String?
  surgeriesOrProsthetics String?
  physicalRestrictions   String?
  medication             String?
  allergies              String?
  bloodType              String?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Exercise {
  id          Int              @id @default(autoincrement())
  name        String
  muscleGroup String
  category    ExerciseCategory
  defaultSets Int?
  defaultReps Int?
  technique   String?
  equipment   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  routineEntries RoutineExerciseEntry[]
}

model RoutineTemplate {
  id                    Int              @id @default(autoincrement())
  name                  String
  description           String?
  objective             String?
  generalConsiderations String?
  clientId              Int?
  client                Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sourceTemplateId      Int?
  sourceTemplate        RoutineTemplate? @relation("TemplateClone", fields: [sourceTemplateId], references: [id])
  clones                RoutineTemplate[] @relation("TemplateClone")
  startDate             DateTime?
  durationWeeks         Int?
  status                RoutineStatus    @default(draft)
  sessions              RoutineSession[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model RoutineSession {
  id                 Int                    @id @default(autoincrement())
  routineTemplateId  Int
  routineTemplate    RoutineTemplate        @relation(fields: [routineTemplateId], references: [id], onDelete: Cascade)
  name               String
  warmupPrescription String?
  order              Int
  entries            RoutineExerciseEntry[]
}

model RoutineExerciseEntry {
  id               Int            @id @default(autoincrement())
  routineSessionId Int
  routineSession   RoutineSession @relation(fields: [routineSessionId], references: [id], onDelete: Cascade)
  exerciseId       Int
  exercise         Exercise       @relation(fields: [exerciseId], references: [id])
  phase            RoutinePhase
  block            String?
  kg               Float?
  reps             Int?
  series           Int?
  notes            String?
  order            Int
}
